# Пример настроек для сервера. Скопируйте нужные строки в файл .env
# (файл .env в GitHub не загружается!).
DJANGO_SECRET_KEY=укажите-длинный-уникальный-секретный-ключ
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=192.168.1.11,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.11:20010
DJANGO_USE_HTTPS=False
SQLITE_PATH=/app/data/db.sqlite3
APP_BIND_IP=0.0.0.0
APP_PORT=20010
